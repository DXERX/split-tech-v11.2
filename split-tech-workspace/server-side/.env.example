# ═══════════════════════════════════════════════════════════════════════════
# Split Intelligence — Environment Variables Template
# Copy to .env and fill in real values. Never commit the real .env file.
# Production: VITE_* public keys are injected at image build from GCP Secret Manager.
# ═══════════════════════════════════════════════════════════════════════════

# ─── Self-hosted GoTrue + PostgREST (via splittech-api proxy) ─────────────
VITE_SUPABASE_URL=https://YOUR-CLOUD-RUN-API.run.app
VITE_SUPABASE_ANON_KEY=your-anon-jwt-from-secret-manager

# ─── Split Intelligence API (Cloud Run) ─────────────────────────────────
VITE_API_URL=https://YOUR-CLOUD-RUN-API.run.app

# ─── App Identity ──────────────────────────────────────────────────────────
VITE_APP_URL=https://splittech.sa
VITE_APP_NAME=Split Intelligence
VITE_SUPPORT_EMAIL=support@splittech.sa

# ─── Moyasar (publishable only — never sk_ in frontend) ───────────────────
VITE_MOYASAR_PUBLISHABLE_KEY=pk_live_xxx-from-secret-manager

# ─── Cloudflare Turnstile (OPTIONAL — signup works without it) ─────────────
VITE_TURNSTILE_SITE_KEY=

# ═══════════════════════════════════════════════════════════════════════════
# SERVER-SIDE SECRETS — managed via GCP Secret Manager only
# ═══════════════════════════════════════════════════════════════════════════

# Sentry — leave VITE_SENTRY_DSN empty to disable error monitoring entirely.
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_SENTRY_REPLAY_SAMPLE_RATE=
VITE_SENTRY_REPLAY_ON_ERROR_RATE=
VITE_APP_ENV=
VITE_APP_VERSION=
